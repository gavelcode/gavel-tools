# gazelle:prefix github.com/gavelcode/gavel-tools
# The gazelle target lives in //dev: it is a dev dependency, and this package is
# loaded by every consumer (aspects reference //:go.mod).

exports_files(
    [
        "MODULE.bazel",
        "go.mod",
        "go.sum",
        ".bcr/presubmit.yml",
        ".bcr/modules/go/presubmit.yml",
        ".bcr/modules/java/presubmit.yml",
        ".bcr/modules/python/presubmit.yml",
        ".bcr/modules/rust/presubmit.yml",
        ".bcr/modules/rust_rs/presubmit.yml",
        ".bcr/modules/typescript/presubmit.yml",
        ".bcr/modules/web/presubmit.yml",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "gavel_lint_config",
    srcs = [".golangci.yml"],
    visibility = ["//visibility:public"],
)
