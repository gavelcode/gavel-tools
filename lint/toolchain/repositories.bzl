"""Repository rules that deliver the gavel-lint toolchain.

Release: one repo per execution platform downloads the prebuilt binary attached
to the GitHub release (checksum from integrity.bzl). Development: a hub that
points at the source-built binary. Either way the aspects only see the
`//lint/toolchain:toolchain_type` toolchain.
"""

load(":integrity.bzl", "GAVEL_LINT_INTEGRITY", "GAVEL_LINT_VERSION")

_TOOLCHAIN_TYPE = str(Label("//lint/toolchain:toolchain_type"))
_TOOLCHAIN_RULE_BZL = str(Label("//lint/toolchain:toolchain.bzl"))
_SOURCE_IMPL = str(Label("//lint/toolchain/source:impl"))

# Where release binaries live; swap it with GAVEL_LINT_BASE_URL (a --repo_env) to
# test a locally built release without publishing one.
_RELEASE_BASE_URL = "https://github.com/gavelcode/gavel-tools/releases/download/v{version}"
BASE_URL_ENV = "GAVEL_LINT_BASE_URL"

GAVEL_LINT_PLATFORMS = {
    "darwin_amd64": ["@platforms//os:macos", "@platforms//cpu:x86_64"],
    "darwin_arm64": ["@platforms//os:macos", "@platforms//cpu:aarch64"],
    "linux_amd64": ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    "linux_arm64": ["@platforms//os:linux", "@platforms//cpu:aarch64"],
}

def _reproducible(rctx):
    # repo_metadata exists from Bazel 8.3; older Bazels just refetch on demand.
    if hasattr(rctx, "repo_metadata"):
        return rctx.repo_metadata(reproducible = True)
    return None

def release_asset_name(platform):
    """File name of a platform's binary among the release assets."""
    return "gavel-lint-" + platform

def _platform_repo_impl(rctx):
    base = rctx.getenv(BASE_URL_ENV) or _RELEASE_BASE_URL.format(version = rctx.attr.version)
    rctx.download(
        url = "{}/{}".format(base.rstrip("/"), release_asset_name(rctx.attr.platform)),
        output = "gavel-lint",
        executable = True,
        sha256 = rctx.attr.sha256,
    )
    rctx.file("BUILD.bazel", """# @generated by @gavel_tools//lint/toolchain:repositories.bzl
load({bzl}, "gavel_lint_toolchain")

exports_files(["gavel-lint"])

gavel_lint_toolchain(
    name = "toolchain",
    binary = "gavel-lint",
    visibility = ["//visibility:public"],
)
""".format(bzl = repr(_TOOLCHAIN_RULE_BZL)))
    return _reproducible(rctx)

gavel_lint_platform_repo = repository_rule(
    implementation = _platform_repo_impl,
    doc = "Downloads the prebuilt gavel-lint binary for one execution platform.",
    environ = [BASE_URL_ENV],
    attrs = {
        "platform": attr.string(mandatory = True, values = GAVEL_LINT_PLATFORMS.keys()),
        "version": attr.string(mandatory = True),
        "sha256": attr.string(mandatory = True),
    },
)

def _toolchains_repo_impl(rctx):
    if rctx.attr.prebuilt:
        content = "# @generated by @gavel_tools//lint/toolchain:repositories.bzl\n"
        for platform, constraints in GAVEL_LINT_PLATFORMS.items():
            content += """
toolchain(
    name = "{platform}",
    exec_compatible_with = {constraints},
    toolchain = "@gavel_lint_{platform}//:toolchain",
    toolchain_type = {type},
)
""".format(platform = platform, constraints = constraints, type = repr(_TOOLCHAIN_TYPE))
    else:
        content = """# @generated by @gavel_tools//lint/toolchain:repositories.bzl
toolchain(
    name = "source",
    toolchain = {impl},
    toolchain_type = {type},
)
""".format(impl = repr(_SOURCE_IMPL), type = repr(_TOOLCHAIN_TYPE))
    rctx.file("BUILD.bazel", content)
    return _reproducible(rctx)

gavel_lint_toolchains_repo = repository_rule(
    implementation = _toolchains_repo_impl,
    doc = "Hub of toolchain() targets, one per platform (prebuilt) or a single source one.",
    attrs = {"prebuilt": attr.bool(mandatory = True)},
)

def declare_gavel_lint_repos(prebuilt):
    """Declares the platform repos (when prebuilt) and the toolchain hub.

    Args:
        prebuilt: True for a release (download binaries), False to build from source.
    """
    if prebuilt:
        for platform in GAVEL_LINT_PLATFORMS:
            gavel_lint_platform_repo(
                name = "gavel_lint_" + platform,
                platform = platform,
                version = GAVEL_LINT_VERSION,
                sha256 = GAVEL_LINT_INTEGRITY[platform],
            )
    gavel_lint_toolchains_repo(name = "gavel_lint_toolchains", prebuilt = prebuilt)
